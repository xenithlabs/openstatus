# ============================================================================
# Docker Environment Configuration (Example)
# ============================================================================
# Copy this file to .env.docker and replace with your actual values
#
# NOTE: Build-time placeholders are set in each service's dofigen.yml file.
# Values in this file override those placeholders at runtime via docker compose.
# Required values are marked with [REQUIRED]

# DATABASE
# ============================================================================
# LibSQL database connection - points to the libsql container
DATABASE_URL=http://libsql:8080
DATABASE_AUTH_TOKEN=


# REDIS & QUEUE
# ============================================================================
# Redis (optional) - for caching
UPSTASH_REDIS_REST_URL=http://localhost:6379
UPSTASH_REDIS_REST_TOKEN=placeholder

# QStash (optional - for background jobs)
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_TOKEN=
QSTASH_URL=https://qstash.upstash.io/v1/publish/

# ANALYTICS
# ============================================================================
# Tinybird (optional - for monitor analytics and charts)
# Leave empty to disable analytics features
# Get from: https://www.tinybird.co
#
# ⚠️  For self-hosted: setting these variables is NOT enough.
# The Tinybird container starts empty — you must deploy the project.
# Run the init script to deploy and get the local admin token:
#   chmod +x scripts/tinybird-self-hosted-init.sh
#   ./scripts/tinybird-self-hosted-init.sh
# Then set both TINY_BIRD_API_KEY and TINYBIRD_TOKEN to the printed token.
# See: docs/tinybird-self-hosted-deployment.md
TINY_BIRD_API_KEY=

# Tinybird token for Go services (checker, private-location) — same as TINY_BIRD_API_KEY
TINYBIRD_TOKEN=

# Tinybird URL — points to the local container
# For docker compose: http://tinybird-local:7181
# For Coolify (service named 'tinybird'): http://tinybird:7181
# Data persists in the tinybird-data Docker volume at /var/lib/clickhouse
TINYBIRD_URL=

# EMAIL
# ============================================================================
# [REQUIRED] Resend API key for sending magic link emails
# Get from: https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here

# SMTP (alternative to Resend — for self-hosted deployments)
# If SMTP_HOST is set, SMTP is used instead of Resend.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM=notifications@example.com

# AUTHENTICATION
# ============================================================================
# [REQUIRED] NextAuth secret - generate with: openssl rand -base64 32
AUTH_SECRET=your-random-secret-here-min-32-chars

# [REQUIRED] Self-hosted mode - enables magic link authentication
# Set to "true" to allow email login without OAuth
SELF_HOST="true"

# GitHub OAuth (optional)
# Get from: https://github.com/settings/developers
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth (optional)
# Get from: https://console.cloud.google.com
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GOOGLE CLOUD
# ============================================================================
# Google Cloud Platform (optional - for scheduled tasks)
GCP_PROJECT_ID=your-value
GCP_LOCATION=your-value
GCP_CLIENT_EMAIL=your-value
GCP_PRIVATE_KEY=your-value

# Cron secret for scheduled jobs
CRON_SECRET=your-random-cron-secret

# API KEYS
# ============================================================================
# Unkey (optional - for API key management)
# Get from: https://unkey.dev
UNKEY_API_ID=
UNKEY_TOKEN=

# Super admin token for privileged operations
SUPER_ADMIN_TOKEN=

# Server region identifier
FLY_REGION=self-hosted

# Checker region identifier (self-hosted deployments)
CHECKER_REGION=self-hosted

# STRIPE
# ============================================================================
# Stripe (optional - for payments)
# Get from: https://stripe.com/docs/keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# VERCEL
# ============================================================================
# Vercel (optional - for custom domains)
# Get from: https://vercel.com
PROJECT_ID_VERCEL=
TEAM_ID_VERCEL=
VERCEL_AUTH_BEARER_TOKEN=

# Vercel Blob storage (optional)
BLOB_READ_WRITE_TOKEN=

# OBSERVABILITY
# ============================================================================
# Sentry (optional - error tracking)
# Get from: https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Axiom (optional - OTLP logging)
# Get from: https://axiom.co
AXIOM_TOKEN=
AXIOM_DATASET=

# OpenPanel (optional - analytics)
# Get from: https://openpanel.dev
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
OPENPANEL_CLIENT_SECRET=

# PagerDuty (optional - alerting)
PAGERDUTY_APP_ID=

# Slack webhook (optional)
SLACK_SUPPORT_WEBHOOK_URL=

# Slack Bot integration (optional)
# Get from: https://api.slack.com/apps
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=

# SMS Notifications via Twilio (optional)
# Get from: https://www.twilio.com/console
TWILLIO_AUTH_TOKEN=
TWILLIO_ACCOUNT_ID=

# AI Gateway / MCP server (optional)
AI_GATEWAY_API_KEY=

# SERVICE CONFIGURATION
# ============================================================================
NODE_ENV=production

# [REQUIRED] Public URL for the application
NEXT_PUBLIC_URL=http://localhost:3002

# NextAuth configuration
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3002

# Encryption key for sensitive data at rest
ENCRYPTION_KEY=your-encryption-key

# Screenshot service (optional)
SCREENSHOT_SERVICE_URL=

# External services
OPENSTATUS_INGEST_URL=https://openstatus-private-location.fly.dev

# Site URL for workflows service (optional)
SITE_URL=http://localhost:3000

# Checker URL (self-hosted - direct HTTP dispatch)
# Points to the checker container when GCP Cloud Tasks are not used
CHECKER_URL=http://checker:8080

# Workflows URL (self-hosted - direct status reporting)
# Points to the workflows container when GCP Cloud Tasks are not used
OPENSTATUS_WORKFLOWS_URL=http://workflows:3000

# Private location token (self-hosted - generated when creating a private location)
# Copy the token from the dashboard's private location settings page.
# Required for the private-probe service to authenticate with private-location.
# The token is passed into the container as OPENSTATUS_KEY.
PRIVATE_LOCATION_TOKEN=

# Additional tokens for multiple private-probe replicas (optional)
# If unset, replicas fall back to PRIVATE_LOCATION_TOKEN.
PRIVATE_LOCATION_TOKEN_2=
PRIVATE_LOCATION_TOKEN_3=

# Docs knowledge base for the AI assistant / MCP server (optional)
# The search_docs and get_doc_page tools query this site's /api/search and
# /api/markdown endpoints. Defaults to the public openstatus.dev docs.
# OPENSTATUS_WEB_BASE_URL=https://www.openstatus.dev

# DEVELOPMENT & TESTING
# ============================================================================
# Turbo build mode
TURBO_ENV_MODE=loose

# Playground API keys (optional)
PLAYGROUND_UNKEY_API_KEY=

# Workspace settings (optional)
WORKSPACES_HIDE_URL=
